{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "",
  "installCommand": "",
  "outputDirectory": ".",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.airesulting.com"
        }
      ],
      "destination": "https://airesulting.com/:path*",
      "permanent": true
    },
    {
      "source": "/field-notes",
      "destination": "/the-signal",
      "permanent": true
    },
    {
      "source": "/signal",
      "destination": "/the-signal",
      "permanent": true
    },
    {
      "source": "/signal-ai-budget",
      "destination": "/the-signal#cost-test",
      "permanent": true
    },
    {
      "source": "/the-spending-gap",
      "destination": "/the-signal#cost-test",
      "permanent": true
    },
    {
      "source": "/the-stealth-spend",
      "destination": "/the-signal#cost-test",
      "permanent": true
    },
    {
      "source": "/the-imagination-gap",
      "destination": "/strategic-direction",
      "permanent": true
    },
    {
      "source": "/the-data-gap",
      "destination": "/data-readiness",
      "permanent": true
    },
    {
      "source": "/the-data-gap-revised",
      "destination": "/data-readiness",
      "permanent": true
    },
    {
      "source": "/the-infrastructure-gap",
      "destination": "/technology-infrastructure",
      "permanent": true
    },
    {
      "source": "/the-governance-gap",
      "destination": "/governance-security",
      "permanent": true
    },
    {
      "source": "/the-experience-gap",
      "destination": "/experience-layer",
      "permanent": true
    },
    {
      "source": "/customer-experience",
      "destination": "/experience-layer",
      "permanent": true
    },
    {
      "source": "/the-adoption-gap",
      "destination": "/workforce-adoption",
      "permanent": true
    },
    {
      "source": "/assessment",
      "destination": "/start",
      "permanent": true
    },
    {
      "source": "/second-opinion",
      "destination": "/start",
      "permanent": true
    },
    {
      "source": "/terms",
      "destination": "/privacy#terms",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/a/:slug",
      "destination": "/api/ref-redirect"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), interest-cohort=()"
        }
      ]
    }
  ]
}
